# Deploy olunan PROD mühiti  →  npm run build:production  (vite build --mode production)
# Dockerfile: BUILD_ENV=production (.ci-cd/prod.yaml); `npm run build` də bu modu işlədir.
# `/api/v1` prefiksi apiUrl-in bir hissəsidir, sonda `/` YOXDUR.
# Host spec 005 Q2 ilə təsdiqlənib. Refresh cookie (SameSite=Strict) yalnız panel
# da `*.cbar.az` altında olanda göndərilir — `.ci-cd/prod.yaml` qeydinə bax.
VITE_API_URL=https://api-cbar-admin.cbar.az/api/v1

# Media önizləməsi/endirmə — **ictimai** api-cbar kökü (`/media/{id}` ona əlavə olunur),
# web-cbar-new `.ci-cd/prod.yaml` `API_URL` dəyəri ilə eyni. Sonda `/` YOXDUR.
VITE_MEDIA_BASE_URL=https://api-cbar.e-cbar.az

# Public site root for "Saytda bax" on the org chart (spec 060). Empty hides the link.
VITE_SITE_URL=https://cbar.e-cbar.az
