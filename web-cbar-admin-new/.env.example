# Bu faylı .env.local kimi kopyalayıb lokal dəyərlərinizi yazın.

# Admin API ünvanı — build zamanı bundle-a yazılır (import.meta.env.VITE_API_URL).
# Mühit faylları: .env.development (npm run dev), .env.dev / .env.test /
# .env.production (npm run build:<env>, Dockerfile BUILD_ENV). `/api/v1` prefiksi
# buradadır — servis yolları API kökünə nisbidir.
VITE_API_URL=/api/v1

# Vite dev server üçün /api proxy hədəfi. Lokal admin API: http://localhost:5253
# Boş qalsa proxy qurulmur.
VITE_API_PROXY_TARGET=http://localhost:5253

# Brauzerdə MSW mock API (API-siz demo). Testlərdə MSW həmişə işləyir.
# VITE_ENABLE_MSW=true

# Public site root for "Saytda bax" on the org chart (spec 060). Empty hides the link.
VITE_SITE_URL=
