{
  "name": "cbar-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "install:public": "node scripts/install/install-public.mjs",
    "install:nexus": "node scripts/install/install-nexus.mjs",
    "docker:build": "node scripts/docker/build-image.mjs",
    "dev": "vite",
    "local:testcbar": "node scripts/dev/local-testcbar.mjs",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:test": "tsc -b && vite build --mode test",
    "build:production": "tsc -b && vite build --mode production",
    "lint": "eslint .",
    "check:kit": "node scripts/check-kit-only.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:layout-fixtures": "node scripts/check-layout-fixtures.mjs",
    "check:chart-layout": "node scripts/check-chart-layout.mjs",
    "audit": "npm audit --audit-level=high",
    "roundtrip": "node scripts/roundtrip-check.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run check:kit && npm run check:i18n && npm run check:layout-fixtures && npm run check:chart-layout && tsc -b && npm run test:run && npm run build",
    "prepare": "node scripts/git-hooks/install.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-details": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-link": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/extension-text-style": "3.31.3",
    "@tiptap/extension-youtube": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@cbar/lib-react-ui-kit": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
