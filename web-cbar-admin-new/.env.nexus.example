# Nexus credential-ları — NÜMUNƏ fayl. Real faylı bundan yarat və doldur:
#
#   PowerShell:  Copy-Item .env.nexus.example .env.nexus
#   bash:        cp .env.nexus.example .env.nexus
#
# `.env.nexus` lokaldır və commit OLUNMUR (.gitignore-dadır) — şifrə repo-ya düşmür.
# Bu nümunə faylda heç vaxt real dəyər saxlanılmır.
#
# Quraşdırma: npm run install:nexus  (dəyişənləri əl ilə set etmək lazım deyil —
# skript bu faylı özü oxuyur). Ətraflı: README "Quraşdırma" bölməsi.

NEXUS_USERNAME=istifadeci-adi
NEXUS_PASSWORD=sifre
