# Deploy olunan DEV mühiti  →  npm run build:dev  (vite build --mode dev)
# Dockerfile: BUILD_ENV=dev (.ci-cd/dev.yaml). Lokal `npm run dev` bu faylı YOX,
# `.env.development`-i oxuyur (mode adı fərqlidir — proxy konfiqi ilə toqquşmasın deyə).
# `/api/v1` prefiksi apiUrl-in bir hissəsidir, sonda `/` YOXDUR.
VITE_API_URL=https://api-cbar-admin-test.cbar.az/api/v1

# Media önizləməsi/endirmə — **ictimai** api-cbar kökü (`/media/{id}` ona əlavə olunur),
# web-cbar-new `.ci-cd/dev.yaml` `API_URL` dəyəri ilə eyni. Sonda `/` YOXDUR.
VITE_MEDIA_BASE_URL=https://api-cbar-test.e-cbar.az

# Public site root for "Saytda bax" on the org chart (spec 060). Empty hides the link.
# TODO(devops): the dev site has no hostname of its own (web-cbar-new .ci-cd/dev.yaml).
VITE_SITE_URL=
