# Deploy olunan TEST mühiti  →  npm run build:test  (vite build --mode test)
# Dockerfile: BUILD_ENV=test (.ci-cd/test.yaml). Vitest də `test` mode-dadır, amma
# vitest.config.ts `test.env.VITE_API_URL=/api/v1` ilə bu dəyəri üstələyir.
# `/api/v1` prefiksi apiUrl-in bir hissəsidir, sonda `/` YOXDUR.
VITE_API_URL=https://api-cbar-admin-test.cbar.az/api/v1

# Media önizləməsi/endirmə — **ictimai** api-cbar kökü (`/media/{id}` ona əlavə olunur),
# web-cbar-new `.ci-cd/test.yaml` `API_URL` dəyəri ilə eyni. Sonda `/` YOXDUR.
# Vitest bu dəyəri `vitest.config.ts`-də boş sətirlə üstələyir.
VITE_MEDIA_BASE_URL=https://api-cbar-test.cbar.az

# Public site root for "Saytda bax" on the org chart (spec 060). Empty hides the link.
VITE_SITE_URL=https://temp.cbar.az
