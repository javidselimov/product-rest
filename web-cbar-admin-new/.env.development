# Lokal inkişaf, lokal admin API ilə.  →  npm run dev
#
# Sorğular `http://localhost:5173/api/v1/...` ünvanına gedir və Vite dev server onları
# aşağıdakı hədəfə proxy edir (CORS-suz, eyni mənbə). `/api/v1` prefiksi apiUrl-dədir —
# servis yolları API kökünə nisbidir (`/laws`, `/pages/tree`).
#
# Admin API-ni əvvəlcə qaldır: `dotnet run --project api-cbar-admin/src/Cbar.AdminApi`
# və ya root-dan `.\dev.ps1 -NextAdmin`.

VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:5253

# Media önizləməsi/endirmə: fayl baytlarını **ictimai** api-cbar verir
# (`GET /media/{id}`, autentifikasiyasız) — admin API-də belə endpoint yoxdur.
# Boş qalır: sorğu `http://localhost:5174/media/{id}`-ə gedir və Vite onu aşağıdakı
# hədəfə proxy edir. Public API-ni qaldır: `dotnet run --project api-cbar/src/Cbar.WebApi`.
VITE_MEDIA_BASE_URL=
VITE_MEDIA_PROXY_TARGET=http://localhost:5139

# MSW ilə API-siz demo rejimi (yalnız testlərdə default aktivdir):
# VITE_ENABLE_MSW=true

# Public site root for "Saytda bax" on the org chart (spec 060). Empty hides the link.
VITE_SITE_URL=http://localhost:3001
