# Təşkilat sabiti: bu registry bütün repolarda eynidir və UI kit (@cbar/…) məhz
# buradan gəlir — template-i yeni layihəyə uyğunlaşdıranda bu faylı DƏYİŞMƏYİN.
#
# Only the @cbar scope goes to Nexus. Everything else (react, vite, …) keeps
# coming from the public registry — npm-hosted is a hosted repo, not a proxy, so
# a global `registry=` line here would break every other install.
@cbar:registry=https://nexus.cbar.az/repository/npm-hosted/

# Basic auth: username + password, base64-encoded as "user:password". npm does not
# do the encoding — it sends whatever the variable holds — so build it first:
#
#   export NPM_AUTH=$(printf '%s:%s' 'USER' 'PASSWORD' | base64 | tr -d '\n')
#
# The value stays in the environment, never in this file: .npmrc is committed.
//nexus.cbar.az/repository/npm-hosted/:_auth=${NPM_AUTH}

# If a bearer token is issued later (nexus.cbar.az → your user → NPM Bearer Token),
# prefer it over the line above — swap in this one and export NPM_TOKEN instead.
# Do not keep both: npm sends the token and silently ignores the basic credential.
# //nexus.cbar.az/repository/npm-hosted/:_authToken=${NPM_TOKEN}
