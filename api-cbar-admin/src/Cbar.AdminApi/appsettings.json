{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "RefreshIdleHours": 8,
    "RefreshAbsoluteDays": 7
  },
  "Auth": {
    "RefreshReuseGraceSeconds": 30,
    "RefreshCookie": {
      "Name": "cbar_admin_rt",
      "Secure": true
    }
  }
}
