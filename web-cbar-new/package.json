{
  "name": "web-cbar-next",
  "version": "0.1.0",
  "private": true,
  "description": "cbar.az public saytı (Next.js App Router, CBAR UI kit)",
  "repository": {
    "type": "git",
    "url": "https://gitlab.cbar.az/cbar/web-cbar-next"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "install:public": "node scripts/install/install-public.mjs",
    "install:offline": "node scripts/install/install-offline.mjs",
    "install:nexus": "node scripts/install/install-nexus.mjs",
    "vendor:kit": "node scripts/install/vendor-kit.mjs",
    "docker:build": "node scripts/docker/build-image.mjs",
    "dev": "next dev -p 3001",
    "local:testcbar": "node scripts/dev/local-testcbar.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "check:self-contained": "node scripts/check-self-contained.mjs",
    "check:layout-fixtures": "node scripts/check-layout-fixtures.mjs",
    "check:chart-layout": "node scripts/check-chart-layout.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "node scripts/setup/setup.mjs",
    "setup:check": "node scripts/setup/setup-check.mjs",
    "audit": "node scripts/audit/audit-check.mjs",
    "verify": "npm run setup:check && npm run check:self-contained && npm run check:layout-fixtures && npm run check:chart-layout && npm run lint && npm run typecheck && npm run test:run && npm run build",
    "prepare": "node scripts/git-hooks/install.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "echarts": "6.1.0",
    "i18next": "^26.4.0",
    "next": "^16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "zod": "^4.6.6",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "@cbar/lib-react-ui-kit": "^0.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
