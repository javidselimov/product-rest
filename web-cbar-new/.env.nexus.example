# Daxili registry credential-ları — `npm run install:nexus` bunu oxuyur.
#
# NECƏ: bu faylı `.env.nexus` adı ilə kopyala və doldur.
#   PowerShell:  Copy-Item .env.nexus.example .env.nexus
#   bash:        cp .env.nexus.example .env.nexus
#
# `.env.nexus` **gitignored**-dur və heç vaxt commit olunmur (Maddə VIII.3).
# Skript onu shell-ə source ETMİR: dəyərlər yalnız müvəqqəti, 0600 icazəli
# `--userconfig` faylına yazılır və proses bitəndə silinir.
#
# CI-da bu fayl yoxdur — dəyərlər masked GitLab CI/CD variable-larından gəlir
# (NEXUS_USERNAME, NEXUS_PASSWORD).

NEXUS_USERNAME=istifadeci-adi
NEXUS_PASSWORD=sifre

# Registry ünvanı və scope. `npm run setup` `.npmrc`-dəki placeholder-ləri
# əvəzləyəndən sonra bu iki sətir lazım deyil — skript onları `.npmrc`-dən oxuyur.
# Setup-dan ƏVVƏL quraşdırmaq istəyirsinizsə, buradakı dəyərlər üstün gəlir.
NEXUS_SCOPE=@cbar
NEXUS_REGISTRY_URL=https://nexus.cbar.az/repository/npm-hosted/
