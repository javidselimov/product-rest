{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/session-context.mjs"],
            "timeout": 30,
            "statusMessage": "Konstitusiya kontekstə yüklənir"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/prompt-context.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/guard.mjs"],
            "timeout": 15,
            "statusMessage": "Konstitusiya qaydaları yoxlanılır"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/stop-verify.mjs"],
            "timeout": 420,
            "statusMessage": "Keyfiyyət qapısı: lint + typecheck"
          }
        ]
      }
    ]
  }
}
