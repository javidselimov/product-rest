# Bu faylı `.env` adı ilə kopyalayın və dəyərləri özünüz doldurun.
# `.env` git-ə düşmür — credential-lar yalnız sizin maşınınızda qalır.

# Yazma hüququ olan bağlantı (cbar_web_ro YOX)
PG=postgres://user:password@host:5433/cbar

# API-lərin MediaStorage__* dəyərləri ilə eyni olmalıdır
MINIO_ENDPOINT=s3.cbar.az:443
MINIO_USE_SSL=true
MINIO_REGION=cbar
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=cbar-media-test

# Köhnə fayl serveri (yalnız storage_key nisbi yol olduqda işlədilir)
SOURCE_BASE=https://uploads.cbar.az

