{
  "minimum-stability": "stable",
  "require": {
    "php": ">=7",
    "yidas/yii2-composer-bower-skip": "~2.0.0",
    "yiisoft/yii2": "~2.0.5",
    "yiisoft/yii2-bootstrap": "~2.0.0",
    "yiisoft/yii2-swiftmailer": "~2.0.0",
    "phpoffice/phpspreadsheet": "1.8.2",
    "kartik-v/yii2-grid": "@dev",
    "kartik-v/yii2-tree-manager": "@dev",
    "ogheo/yii2-htmlcompress": "*",
    "league/flysystem-sftp": "^1.0",
    "himiklab/yii2-search-component-v2": "*",
    "zendframework/zendsearch": "2.0.0rc6",
    "justinvoelker/yii2-separatedpager": "*",
    "zelenin/yii2-rss": "~0.1",
    "codemix/yii2-excelexport": "^2.7",
    "yiisoft/yii2-httpclient": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "yiisoft/yii2-debug": "~2.0.0",
    "yiisoft/yii2-gii": "~2.0.0",
    "yiisoft/yii2-faker": "~2.0.0",
    "codeception/base": "^2.2.3",
    "codeception/verify": "~0.3.1",
    "codeception/specify": "~0.4.3"
  },
  "config": {
    "fxp-asset": {
      "installer-paths": {
        "npm-asset-library": "vendor/npm",
        "bower-asset-library": "vendor/bower"
      }
    },
    "process-timeout": 1800,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "scripts": {
    "post-create-project-cmd": [
      "yii\\composer\\Installer::postCreateProject"
    ]
  },
  "extra": {
  }
}
