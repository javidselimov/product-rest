<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the public API's database-free logic (key parsing, response shapes, the page tree).
    The query filters (published, not deleted, locale visibility) need PostgreSQL and are still checked by
    running the stack. Lives outside src/, so the Dockerfile (which restores and copies only src/) is unaffected.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Cbar.WebApi\Cbar.WebApi.csproj" />
  </ItemGroup>

</Project>
